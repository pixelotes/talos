{"id": "en-c06", "lang": "en", "given": "the word is in the store with a gloss in the conversation language", "turns": [{"user": "what does it mean?", "expect": {"status": "asks", "intent": "define.word", "slot": "word"}}, {"user": "ephemeral", "expect": {"status": "answered", "intent": "define.word", "follow_up": true}}]}
