{"id": "en-c01", "lang": "en", "turns": [{"user": "hello", "expect": {"status": "answered", "intent": "smalltalk.greet"}}, {"user": "what time is it?", "expect": {"status": "answered", "intent": "clock.now"}}, {"user": "thanks", "expect": {"status": "answered", "intent": "smalltalk.thanks"}}, {"user": "bye", "expect": {"status": "answered", "intent": "smalltalk.bye"}}]}
